{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run backend integration suite",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"test_pipeline.py"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Knowledge Hub on 8002",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"uvicorn",
				"backend.main:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8002",
				"--reload"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}